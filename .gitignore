update-notes-media/

# ---------------------------------------------------------------
# Rewritten by Herdr on every start
# ---------------------------------------------------------------
AGENTS.md
gpui-kit.d.ts
herdr.d.ts
frame/
icons/
jsconfig.json
mods/*/gpui-kit.d.ts
mods/*/herdr.d.ts
mods/*/jsconfig.json

